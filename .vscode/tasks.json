{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cloudflared",
      "type": "shell",
      "command": "cloudflared access tcp --hostname db.rafifauzan.site --url localhost:6432",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Development",
      "dependsOn": [
        "Cloudflared",
        "Backend",
        "Frontend",
      ],
      "dependsOrder": "parallel"
    }
  ]
}